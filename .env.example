# PULSE + R4ISE — satu-satunya contoh konfigurasi.
# Instalasi baru: salin menjadi .env. Jangan menimpa .env yang sudah terisi.
# Isi API key di komputer sendiri; jangan bagikan file .env.

# Akses blockchain: URL mainnet dibentuk otomatis dari satu key.
ALCHEMY_API_KEY=
ALCHEMY_CHAINS=SOL,BASE,ETH,ARB,BSC,AVAX,ROBINHOOD,HYPE,ARC
ALCHEMY_MIN_INTERVAL_SECONDS=0.35
ALCHEMY_RATE_LIMIT_COOLDOWN_SECONDS=2.0

# Default active chains: Ethereum, Base, BSC, Solana and Robinhood.
ETHEREUM_ENABLED=true
BASE_ENABLED=true
BSC_ENABLED=true
SOLANA_ENABLED=true
ROBINHOOD_ENABLED=true
# Arbitrum/Avalanche/HyperEVM/Arc remain endpoint-only.
ARBITRUM_ENABLED=false
AVALANCHE_ENABLED=false
HYPEREVM_ENABLED=false
ARC_ENABLED=false

# Discovery kandidat otomatis ETH/Base/BSC/Robinhood, tanpa wallet awal.
DISCOVERY_ENABLED=true
EVM_DISCOVERY_ENABLED=true
DISCOVERY_AUTO_PROMOTE=false
DISCOVERY_REQUIRE_PERF_FOR_PROMOTE=true
DISCOVERY_MIN_EVIDENCE=3
DISCOVERY_MIN_PERF_SAMPLES=3
DISCOVERY_PERF_PRIMARY_HORIZON=1d
DISCOVERY_PERF_HIT_TARGET=2.0
EVM_DISCOVERY_MIN_HIT_RATE=50
EVM_DISCOVERY_MAX_LOGS_PER_BLOCK=200
DISCOVERY_MAX_CANDIDATES=200
DISCOVERY_MAX_NEW_PER_DAY=20
DISCOVERY_MAX_PROMOTED=25
DISCOVERY_MAX_WATCHED_TOTAL=100

# Harga untuk evaluasi kandidat. FOMO opsional, bukan syarat discovery EVM.
DEXSCREENER_ENABLED=true
PRICE_POLL_INTERVAL_SECONDS=60
FOMO_ENABLED=true
FOMO_API_KEY=
# Leaderboard reads consume provider credits; increase interval to reduce usage.
FOMO_REFRESH_SECONDS=300

# Watchlist tambahan opsional. Solana masih membutuhkan wallet awal.
WATCH_WALLETS_ETHEREUM=
WATCH_WALLETS_BASE=
WATCH_WALLETS_BSC=
WATCH_WALLETS_ROBINHOOD=
WATCH_WALLETS_SOLANA=
SMART_MONEY_LIST_PATH=data/smart_money.json
KOL_LIST_PATH=data/kol.json

# Notifikasi tetap mati sampai pengujian selesai.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# Penyimpanan dan koneksi.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/sme.db
ADMIN_TOKEN=change-me
EVM_CONFIRMATION_DEPTH=3
EVM_MAX_BLOCKS_PER_CYCLE=20
POLL_INTERVAL_SECONDS=8
PROVIDER_TIMEOUT_SECONDS=15
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE=0.5
# Pada DB baru, polling dimulai setelah head terkonfirmasi saat startup.
# START_BLOCK hanya untuk backfill yang disengaja; jangan isi sembarang angka.
